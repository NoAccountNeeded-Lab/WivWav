# apps/ops environment variables
#
# Copy to .env.local for local development: cp apps/ops/.env.example apps/ops/.env.local

# Base URL the browser uses for anything NOT proxied through the BFF (currently unused
# by ops browser code directly — kept for parity with other apps' API URL conventions).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side base URL for apps/ops → apps/api calls (BFF proxy, apiFetch). Defaults to
# NEXT_PUBLIC_API_URL when unset; set separately when the API is reachable at a
# different address from inside the ops container (e.g. Docker service name).
API_INTERNAL_URL=http://localhost:3001

# Shared secret injected as `Authorization: Bearer <secret>` on every BFF call to the
# API's /admin/* surface. Must match the API's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=

# HMAC secret used to sign the operator session cookie (apps/ops/src/lib/session.ts).
# Required in production — the app throws at session-creation/verification time
# without it. A fixed insecure fallback is used in non-production only.
OPS_SESSION_SECRET=

# Single shared operator credential for the ops login page (#450 D1 — proportional
# to a single-operator beta; revisit with OIDC once operator count grows).
OPS_ADMIN_USERNAME=operator
OPS_ADMIN_PASSWORD=
