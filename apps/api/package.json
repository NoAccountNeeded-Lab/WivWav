{
  "name": "@wivwav/api",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/fastify": "^8.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^10.64.0",
    "@sinclair/typebox": "^0.34.49",
    "@wivwav/agents": "workspace:*",
    "@wivwav/db": "workspace:*",
    "@wivwav/logger": "workspace:*",
    "@wivwav/observability": "workspace:*",
    "@wivwav/queue": "workspace:*",
    "@wivwav/search": "workspace:*",
    "@wivwav/types": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.59.0",
    "p-retry": "^8.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@wivwav/config": "workspace:*",
    "@wivwav/scraper-sources": "workspace:*",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
