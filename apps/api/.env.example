NODE_ENV=development
PORT=4001
HOST=0.0.0.0
RATE_LIMIT_MAX=100

DATABASE_URL=postgresql://wav:wav@localhost:5432/wivwav

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=wav_master_key
# Optional; defaults to the existing live listings index.
# MEILISEARCH_INDEX_NAME=listings

VALKEY_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6379

# Required after the browser-job cutover: the API consumes the three browser
# queues and dispatches them to connected apps/worker instances. Set false only
# as the first half of rollback, together with restoring the prior scraper image.
WORKER_GATEWAY_ENABLED=true

# http://localhost:4000 is the local-dev web app (`make dev`); :3000 is the
# Dockerized web app (`make up`). Both are allowed since either can hit this
# API depending on which path you're running.
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# Secret config DB encryption (AES-256-GCM, 64-char hex / 32 bytes).
# Required — the API refuses to start without this set. Generate one and
# uncomment the line below with the generated value:
#   openssl rand -hex 32
# CONFIG_ENCRYPTION_SECRET=

# Web SSR /v1 bypass and bounded /internal/config/ai.intake.model read.
# API + web only; never provision to worker clients.
# Never authorizes worker, operator, or diagnostic routes.
# Generate a distinct value for each identity: openssl rand -hex 32
# INTERNAL_API_SECRET=

# Worker protocol only: /internal/workers/* and /internal/scraper/*.
# Set each worker client WORKER_TOKEN to this value, never the web identity.
# Production worker routes fail closed without it; no INTERNAL fallback.
# WORKER_API_SECRET=

# Operator API and Bull Board identity. API + ops only; never web or MCP.
# Required to unlock operator routes in production.
# OPS_API_SECRET=

# Read-only /diagnostics identity for desktop MCP clients. Production
# fails closed when absent, even with OPS configured. Diagnostics accepts
# OPS asymmetrically; the diagnostic identity never grants operator access.
# DIAGNOSTIC_API_SECRET=

# Loki log aggregation backend (used by GET /internal/ops/logs).
# Default works for local `make dev`. Docker Compose overrides this to http://loki:3100.
# LOKI_URL=http://localhost:3100

# Stripe webhook signing secret (from the Stripe Dashboard's webhook endpoint
# config). Required for POST /webhooks/stripe to accept events — when unset,
# that endpoint refuses all requests with 503 rather than trusting an
# unverifiable payload. Not needed for local dev unless you're testing the
# tier-upgrade webhook (e.g. via `stripe listen --forward-to`).
# STRIPE_WEBHOOK_SECRET=

# Sentry error monitoring (disabled unless explicitly enabled)
# Create a project at https://sentry.io and paste the DSN here.
# Omit the enable flag to disable Sentry entirely (fine for local dev).
# SENTRY_ENABLED=true
# SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/789

# Grafana alert-instance state (used by GET /internal/v1/grafana/alerts, #890).
# Default matches the `obs` profile's Docker Compose Grafana (anonymous
# admin, no token required for local dev).
# GRAFANA_URL=http://localhost:3003
# GRAFANA_API_TOKEN=

# Sentry issues API (used by GET /internal/v1/sentry/issues, #890) — a read-only
# server-side token, distinct from apps/web's build-time SENTRY_AUTH_TOKEN/
# SENTRY_ORG/SENTRY_PROJECT (source-map upload scope only). Generate at
# sentry.io/settings/auth-tokens/ with project:read scope. All three unset
# is fine for local dev — the route reports itself unavailable.
# SENTRY_ISSUES_AUTH_TOKEN=
# SENTRY_ISSUES_ORG=your-org-slug
# SENTRY_ISSUES_PROJECT=wivwav-api

# Deployed commit SHA, set by the deploy pipeline (#775). Surfaced verbatim
# by GET /diagnostics/diagnostic-context as fixed-size revision metadata.
# Defaults to 'unknown' when unset — fine for local dev.
# GIT_SHA=

# Enable only after verified full search rebuild; see docs/ops/shopping-filters-rollout.md
WAV_SHOPPING_FILTERS_ENABLED=false
