{
  "name": "@wivwav/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wivwav/logger": "workspace:*",
    "@wivwav/scraper-sources": "workspace:*",
    "@wivwav/types": "workspace:*",
    "dotenv": "^17.4.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@wivwav/config": "workspace:*",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
