{
  "name": "@wivwav/scraper",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:fixtures": "vitest run src/sources/fixture-contract.test.ts",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "clean": "rm -rf dist",
    "eval": "node --import tsx evals/run-eval.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "@sentry/node": "^10.57.0",
    "@wivwav/agents": "workspace:*",
    "@wivwav/db": "workspace:*",
    "@wivwav/logger": "workspace:*",
    "@wivwav/observability": "workspace:*",
    "@wivwav/queue": "workspace:*",
    "@wivwav/search": "workspace:*",
    "@wivwav/types": "workspace:*",
    "dotenv": "^17.4.2",
    "meilisearch": "^0.58.0",
    "p-retry": "^8.0.0",
    "sharp": "^0.34.5",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@wivwav/config": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
