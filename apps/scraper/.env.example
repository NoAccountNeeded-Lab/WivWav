NODE_ENV=development

DATABASE_URL=postgresql://wav:wav@localhost:5432/wivwav

QUEUE_REDIS_URL=redis://localhost:6379

MEILI_HOST=http://localhost:7700
MEILI_API_KEY=wav_master_key
# Dev Container: DATABASE_URL is set automatically via remoteEnv — the value above is for local dev only.

# Ollama — set OLLAMA_BASE_URL if running outside localhost (e.g. in Docker).
# Omit to disable AI-assisted selector remapping (the scraper degrades safely).
# Pin the model tag to a specific quantisation to prevent version drift across
# different pull dates. llama3.2:3b requires ~4 GB RAM; no GPU required.
# See docs/design/scraper-ai-provider-production.md for the production decision record.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# AI provider via config DB (set provider, model, and API key in /ops/ai instead of env vars)
# CONFIG_API_URL=http://localhost:3001
# INTERNAL_API_SECRET=  # must match INTERNAL_API_SECRET in apps/api

# Scraper behavior
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_DELAY_MS=2000
SCRAPER_HEADLESS=true

# Google Places API — used by the dealer-enrich job to fetch ratings and reviews.
# Get a key at https://console.cloud.google.com/apis/credentials (Places API must be enabled).
# Omit to disable dealer enrichment (the job exits early with a warning log).
# Free tier: 100 requests/day. The job caps at 50 dealers/run (2 requests each).
# GOOGLE_PLACES_API_KEY=

# Sentry error monitoring (disabled unless explicitly enabled)
# Create a project at https://sentry.io and paste the DSN here.
# Omit the enable flag to disable Sentry entirely (fine for local dev).
# SENTRY_ENABLED=true
# SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/789
