{
  "extends": "@wivwav/config/tsconfig",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "./dist",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/stories"]
}
