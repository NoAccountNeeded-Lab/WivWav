{
  "permissions": {
    "allow": [
      "Bash(gh issue comment *)",
      "Bash(ansible-playbook * --tags wivwav *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check-docs.sh"
          }
        ]
      }
    ]
  }
}
