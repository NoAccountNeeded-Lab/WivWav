.vitest-attachments/

# Agents pipeline output (per-run state; not shared across machines)
**/.agents/*
!/.agents/skills/
!/.agents/skills/**

# Codex project skills (/.agents/skills, repo root only) are committed so
# they travel with the repo; everything else under any .agents/ directory,
# including nested ones like packages/sdlc-cli/.agents/, is ephemeral
# sprint-run state.

# Claude Code subagent worktrees
.claude/worktrees/

# design-sync (converter scripts, generated build, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
apps/web/.ds-generated/globals.compiled.css
