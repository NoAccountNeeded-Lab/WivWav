generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum SourceStatus {
  active
  paused
  error
  needs_remapping
}

enum ConversionType {
  rear_entry
  side_entry
  unknown
}

enum RampType {
  in_floor
  fold_out
  fold_in
  none
  unknown
}

/// Whether the WAV conversion is planned/ordered (proposed) or already installed (complete).
/// Distinct from ConversionType, which describes the physical entry direction, not the build state.
enum ConversionStatus {
  proposed
  complete
  unknown
}

enum WavFeature {
  hand_controls
  transfer_seat
  has_lift
  kneel_system
  lowered_floor
  power_ramp
  tie_down_system
  automatic_door
  motorized_running_board
}

enum ListingCondition {
  new
  used
  certified_pre_owned
}

enum ListingSellerType {
  dealer
  private
}

enum ListingStatus {
  active
  possibly_gone
  gone
}

enum SaleStatus {
  active
  pending
  sold
  gone
}

// ── Vehicle identity ───────────────────────────────────────────────────────

/// A specific physical vehicle, anchored by VIN when available.
/// Only created for listings with a valid, normalized 17-character VIN.
/// Non-VIN listings remain listing-only until high-confidence matching is available.
model Vehicle {
  id             String        @id @default(cuid())
  vin            String?       @unique
  make           String
  model          String
  year           Int
  trim           String?
  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  listings Listing[]

  @@index([make, model, year])
  @@map("vehicle")
}

model Source {
  id              String       @id @default(cuid())
  name            String       @unique
  baseUrl         String
  status          SourceStatus @default(active)
  cronExpression  String       @default("0 */6 * * *")
  timezone        String       @default("America/New_York")
  mappings        Json         @default("[]")
  fingerprintHash String?
  page1Hash       String?
  lastScrapedAt   DateTime?
  lastCheckedAt   DateTime?
  listingCount    Int          @default(0)
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  listings Listing[]

  @@map("sources")
}

model Listing {
  id         String @id @default(cuid())
  sourceId   String
  source     Source @relation(fields: [sourceId], references: [id])
  sourceUrl       String
  buyerUrl        String?
  externalId      String?
  stockNumber     String?
  sourceRecordKey String

  make         String
  model        String
  year         Int
  trim         String?
  vin          String?
  condition    ListingCondition
  sellerType   ListingSellerType

  priceCents Int?
  mileage    Int?
  color      String?
  fuelType   String?
  transmission String?

  // WAV-specific
  conversionType         ConversionType   @default(unknown)
  conversionManufacturer String?
  floorLoweringInches    Float?
  rampType               RampType         @default(unknown)
  conversionStatus       ConversionStatus @default(unknown)
  wavFeatures            WavFeature[]   @default([])
  wheelchairCapacity     Int?

  // Location
  zip   String?
  city  String?
  state String?
  lat   Float?
  lng   Float?

  // Vehicle identity (VIN-only; created for listings with a valid 17-char VIN)
  vehicleId    String?
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Normalized vehicle model reference (optional, populated during enrichment)
  vehicleModelId               String?
  vehicleModelMatchConfidence  String?
  vehicleModel                 VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  // Dealer
  dealerName      String?
  dealerPhone     String?
  dealerWebsite   String?
  dealerProfileId String?
  dealerProfile   DealerProfile? @relation(fields: [dealerProfileId], references: [id])


  images      String[]
  // Raw third-party seller copy. Retained in full for WAV-feature extraction
  // by scraper agents. The public API truncates this to a short snippet
  // (see apps/api/src/routes/listings.ts snippetDescription) so that full
  // dealer copy is not reproduced verbatim in public responses.
  description String?

  // Deduplication
  isDuplicate Boolean @default(false)
  canonicalId String?
  canonical   Listing?  @relation("DuplicateOf", fields: [canonicalId], references: [id])
  duplicates  Listing[] @relation("DuplicateOf")

  status     ListingStatus @default(active)
  saleStatus SaleStatus    @default(active)
  goneAt     DateTime?
  soldAt     DateTime?

  listedAt           DateTime
  updatedAt          DateTime  @updatedAt
  scrapedAt          DateTime  @default(now())
  detailScrapedAt    DateTime?
  processingLockedAt DateTime?

  priceHistory      ListingPriceHistory[]
  mileageHistory    ListingMileageHistory[]
  conversionHistory ListingConversionHistory[]

  @@unique([sourceId, sourceRecordKey])
  @@index([sourceId])
  @@index([sourceUrl])
  @@index([vin])
  @@index([vehicleId, status])
  @@index([vehicleId, listedAt])
  @@index([wavFeatures])
  @@index([isDuplicate])
  @@index([state])
  @@index([make, model])
  @@index([year])
  @@index([priceCents])
  @@index([mileage])
  @@index([listedAt])
  @@index([status])
  @@index([saleStatus])
  @@index([vehicleModelId])
  @@index([processingLockedAt])
  @@index([dealerProfileId])
  @@index([dealerName, zip])
  @@map("listings")
}

model ListingPriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  priceCents Int
  recordedAt DateTime @default(now())

  @@index([listingId, recordedAt])
  @@map("listing_price_history")
}

model ListingMileageHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  mileage    Int
  recordedAt DateTime @default(now())

  @@index([listingId, recordedAt])
  @@map("listing_mileage_history")
}

model ListingConversionHistory {
  id               String           @id @default(cuid())
  listingId        String
  listing          Listing          @relation(fields: [listingId], references: [id])
  conversionStatus ConversionStatus
  wavFeatures      WavFeature[]
  recordedAt       DateTime         @default(now())

  @@index([listingId, recordedAt])
  @@map("listing_conversion_history")
}

model RawPage {
  id          String    @id @default(cuid())
  url         String    @unique
  sourceId    String
  html        String
  scrapedAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([sourceId, processedAt])
  @@index([processedAt, scrapedAt])
  @@map("raw_pages")
}

model ScraperRun {
  id         String   @id @default(cuid())
  sourceId   String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  success    Boolean?
  listingsFound    Int?
  listingsNew      Int?
  listingsUpdated  Int?
  errorMessage     String?

  @@index([sourceId])
  @@map("scraper_runs")
}

// ── Research platform ──────────────────────────────────────────────────────

model VehicleModel {
  id       String  @id @default(cuid())
  make     String
  model    String
  year     Int
  trim     String?
  bodyType String?

  vehicles                   Vehicle[]
  listings                   Listing[]
  recalls                    Recall[]
  complaints                 Complaint[]
  safetyRatings              SafetyRating[]
  modelResearch              VehicleModelResearch[]
  investigations             Investigation[]
  manufacturerCommunications ManufacturerCommunication[]

  @@unique([make, model, year, trim])
  @@index([make, model])
  @@index([year])
  @@map("vehicle_models")
}

model VehicleModelResearch {
  id              String       @id @default(cuid())
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  researchVersion Int          @default(1)
  researchedAt    DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  claims  VehicleModelClaim[]
  sources VehicleModelSource[]

  @@unique([vehicleModelId, researchVersion])
  @@index([vehicleModelId])
  @@map("vehicle_model_research")
}

model VehicleModelSource {
  id         String               @id @default(cuid())
  researchId String
  research   VehicleModelResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceName String
  sourceUrl  String
  fetchedAt  DateTime             @default(now())

  claims VehicleModelClaim[]

  @@index([researchId])
  @@map("vehicle_model_source")
}

model VehicleModelClaim {
  id         String               @id @default(cuid())
  researchId String
  research   VehicleModelResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceId   String?
  source     VehicleModelSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  field      String
  claimText  String
  confidence String               @default("medium")
  createdAt  DateTime             @default(now())

  @@index([researchId])
  @@index([researchId, field])
  @@map("vehicle_model_claim")
}

model Recall {
  id              String       @id @default(cuid())
  nhtsaCampaignId String
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component       String
  summary         String
  remedy          String?
  reportedAt      DateTime
  createdAt       DateTime     @default(now())

  @@unique([nhtsaCampaignId, vehicleModelId])
  @@index([vehicleModelId])
  @@map("recalls")
}

model Complaint {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  mileage        Int?
  crashInvolved  Boolean      @default(false)
  reportedAt     DateTime
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("complaints")
}

model SafetyRating {
  id              String       @id @default(cuid())
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  nhtsaVehicleId  Int          @unique
  description     String?
  overallRating   Int?
  frontCrashRating Int?
  sideCrashRating  Int?
  rolloverRating   Int?
  rolloverRatingText String?
  refreshedAt     DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("safety_ratings")
}

/// NHTSA investigation record. Source: https://api.nhtsa.gov/investigations/investigationsByVehicle
model Investigation {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  openedDate     DateTime
  closedDate     DateTime?
  outcome        String?
  sourceUrl      String
  refreshedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("investigation")
}

/// NHTSA manufacturer communication (Technical Service Bulletin or equivalent).
/// Source: https://api.nhtsa.gov/tsbs/tsbsByVehicle
model ManufacturerCommunication {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  issuedDate     DateTime
  sourceUrl      String
  refreshedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("manufacturer_communication")
}

model ConversionBrand {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  website        String?
  nmedaCertified Boolean  @default(false)
  founded        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ConversionProduct[]

  @@map("conversion_brands")
}

model ConversionProduct {
  id                  String          @id @default(cuid())
  brandId             String
  brand               ConversionBrand @relation(fields: [brandId], references: [id])
  name                String
  conversionType      ConversionType
  rampType            RampType
  floorLoweringInches Float?
  msrpCents           Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([brandId])
  @@map("conversion_products")
}

model VehicleStats {
  id                String   @id @default(cuid())
  make              String
  model             String
  year              Int?
  avgLifespanMiles  Int?
  reliabilityScore  Float?
  reliabilitySource String?
  jdPowerScore      Float?
  dataSourceName    String?
  dataSourceUrl     String?
  methodology       String?
  refreshedAt       DateTime?
  createdAt         DateTime @default(now())

  @@unique([make, model, year])
  @@index([make, model])
  @@map("vehicle_stats")
}

model NmeaDealer {
  id           String   @id @default(cuid())
  name         String
  address      String?
  state        String?
  zip          String?
  phone        String?
  website      String?
  qapCertified Boolean   @default(false)
  city         String?
  lat          Float?
  lng          Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([state])
  @@map("nmea_dealers")
}

// ── Dealer enrichment ─────────────────────────────────────────────────────

model DealerProfile {
  id            String   @id @default(cuid())
  name          String
  zip           String
  googlePlaceId String?  @unique
  rating        Float?
  reviewCount   Int?
  hours         Json?
  enrichedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews  DealerReview[]
  listings Listing[]

  @@unique([name, zip])
  @@map("dealer_profiles")
}

model DealerReview {
  id          String        @id @default(cuid())
  dealerId    String
  dealer      DealerProfile @relation(fields: [dealerId], references: [id])
  authorName  String
  rating      Int
  text        String
  publishedAt DateTime
  source      String        // "google", "dealerrater", etc.

  @@unique([dealerId, source, publishedAt, authorName])
  @@index([dealerId])
  @@map("dealer_reviews")
}

// ── Remote config (append-only) ────────────────────────────────────────────

enum ConfigEntryType {
  string
  number
  boolean
  json
  secret
}

model ConfigEntry {
  id             String          @id @default(cuid())
  key            String
  value          Json?
  type           ConfigEntryType
  description    String?
  encryptedValue String?
  hint           String?
  createdAt      DateTime        @default(now())
  createdBy      String?

  @@index([key, createdAt])
  @@map("config_entry")
}
