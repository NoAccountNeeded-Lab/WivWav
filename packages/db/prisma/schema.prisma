generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum SourceStatus {
  active
  disabled
  paused
  error
  needs_remapping
}

enum ConversionType {
  rear_entry
  side_entry
  unknown
}

enum RampType {
  in_floor
  fold_out
  fold_in
  none
  unknown
}

/// Whether the WAV conversion is planned/ordered (proposed) or already installed (complete).
/// Distinct from ConversionType, which describes the physical entry direction, not the build state.
enum ConversionStatus {
  proposed
  complete
  unknown
}

/// Deterministic resolution status for a claim/evidence-backed field (#499:
/// conversionType, rampType). Distinct from the field's own normalized value
/// enum — `conflicting` and `unknown` here describe how trustworthy the
/// stored value is, never a side/rear/ramp value itself. See
/// docs/data/listing-field-ownership.md and apps/scraper/src/resolution/resolver.ts.
enum FieldResolutionState {
  /// Established by one authoritative vehicle-specific source, or by
  /// agreement between 2+ independent credible vehicle-specific signals.
  verified
  /// Exactly one credible vehicle-specific signal; not yet corroborated.
  source_reported
  /// Two or more credible signals assert incompatible values. The Listing's
  /// normalized value is forced to `unknown` while conflicting; competing
  /// claims remain queryable on ListingFieldClaim for audit/operator triage.
  conflicting
  /// No credible claim exists for this field.
  unknown
}

enum WavFeature {
  hand_controls
  transfer_seat
  has_lift
  kneel_system
  lowered_floor
  power_ramp
  tie_down_system
  automatic_door
  motorized_running_board
}

enum ListingCondition {
  new
  used
  certified_pre_owned
}

enum ListingSellerType {
  dealer
  private
}

enum ListingStatus {
  active
  possibly_gone
  gone
}

/// Controls whether an observed listing may appear in public APIs and search.
/// Source ingestion is default-deny: only a separate validation step may mark
/// a listing eligible.
enum ListingPublicationStatus {
  pending
  eligible
  quarantined
}

enum ListingReportType {
  specs_incorrect
  sold_or_stale
  duplicate
  other
}

enum ListingReportStatus {
  unresolved
  resolved
}

enum SaleStatus {
  active
  pending
  sold
  gone
}

/// Outcome of a vehicle-identity matching decision between two listings.
/// `candidate` — signals suggest a possible match but confidence is too low to act on.
/// `verified` — listings confirmed to represent the same physical vehicle.
/// `rejected` — listings confirmed to NOT represent the same physical vehicle.
/// `split` — a previously linked pair was found to be incorrect and has been undone.
enum VehicleIdentityDecisionState {
  candidate
  verified
  rejected
  split
}

// ── Vehicle identity ───────────────────────────────────────────────────────

/// A specific physical vehicle, anchored by VIN when available.
/// Only created for listings with a valid, normalized 17-character VIN.
/// Non-VIN listings remain listing-only until high-confidence matching is available.
model Vehicle {
  id             String        @id @default(cuid())
  vin            String?       @unique
  make           String
  model          String
  year           Int
  trim           String?
  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  listings          Listing[]
  identityDecisions VehicleIdentityDecision[]

  @@index([make, model, year])
  @@map("vehicle")
}

/// Auditable record of a vehicle-identity matching decision between two listings.
/// Persists the outcome (candidate/verified/rejected/split) and the signals that
/// produced it so non-VIN matching, operator review, and backfill reporting can
/// rely on a durable trail instead of recomputing or destructively merging rows.
/// Listing rows are never merged — a `verified` decision only links both listings
/// to the same `Vehicle` via `Listing.vehicleId`; each listing remains independently
/// queryable by source (mirrors the existing `Listing.canonicalId`/`isDuplicate` pattern).
model VehicleIdentityDecision {
  id String @id @default(cuid())

  /// The two listings under comparison. Always stored with listingAId < listingBId
  /// (string comparison) so a pair has exactly one row regardless of comparison order.
  listingAId String
  listingA   Listing @relation("VehicleIdentityDecisionListingA", fields: [listingAId], references: [id])
  listingBId String
  listingB   Listing @relation("VehicleIdentityDecisionListingB", fields: [listingBId], references: [id])

  /// The vehicle the pair was linked to, if the decision resulted in a link
  /// (typically set for `verified`, null for `candidate`/`rejected`/`split`).
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  state VehicleIdentityDecisionState

  /// Structured record of the contributing and conflicting signals that produced
  /// this state (e.g. matched fields, confidence scores, rule ids). Retained in
  /// full for audit even after the decision is superseded.
  signals Json

  /// The rule or matcher version that produced this decision.
  ruleId String?

  decidedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingAId, listingBId])
  @@index([listingAId])
  @@index([listingBId])
  @@index([vehicleId])
  @@index([state])
  @@map("vehicle_identity_decision")
}

model Source {
  id              String       @id @default(cuid())
  name            String       @unique
  baseUrl         String
  status          SourceStatus @default(active)
  cronExpression  String       @default("0 */6 * * *")
  timezone        String       @default("America/New_York")
  mappings        Json         @default("[]")
  fingerprintHash String?
  page1Hash       String?
  lastScrapedAt   DateTime?
  lastCheckedAt   DateTime?
  /// Timestamp of the most recent complete (all-pages) crawl. Used to enforce
  /// the periodic full-crawl interval even when page-1 is unchanged.
  lastFullCrawlAt DateTime?
  /// Timestamp of the most recent observation of this source (complete or partial).
  lastObservedAt  DateTime?
  listingCount    Int          @default(0)
  errorMessage    String?

  /// Rolling (EWMA) baseline of the per-run error-severity issue rate (0-1),
  /// updated after every source-scrape run regardless of outcome. Used to
  /// detect abrupt drift in a source's data quality that the fixed systemic
  /// threshold alone would miss (e.g. a source whose normal baseline is
  /// already elevated, or one that degrades gradually below the fixed cutoff).
  baselineErrorRate   Float?
  /// Rolling (EWMA) baseline of the per-run missing/unknown field rate (0-1).
  baselineMissingRate Float?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  listings Listing[]

  @@map("sources")
}

model Listing {
  id         String @id @default(cuid())
  sourceId   String
  source     Source @relation(fields: [sourceId], references: [id])
  sourceUrl       String
  buyerUrl        String?
  externalId      String?
  stockNumber     String?
  sourceRecordKey String

  make         String
  model        String
  year         Int
  trim         String?
  vin          String?
  condition    ListingCondition
  sellerType   ListingSellerType

  priceCents Int?
  mileage    Int?
  /// Raw color string from the source (e.g. "Brilliant Silver Metallic"). Retained for provenance.
  /// The canonical color for search/facets is derived by canonicalize.ts in @wivwav/search.
  color      String?
  fuelType   String?
  /// Raw engine description from source (e.g. "3.5L V6 24V PDI DOHC"). Stored separately from
  /// fuelType so engine descriptions are never exposed as fuel type in public facets.
  engine     String?
  transmission String?

  // WAV-specific
  conversionType         ConversionType   @default(unknown)
  conversionManufacturer String?
  floorLoweringInches    Float?
  rampType               RampType         @default(unknown)
  conversionStatus       ConversionStatus @default(unknown)
  wavFeatures            WavFeature[]   @default([])
  wheelchairCapacity     Int?

  /// #499 deterministic resolution state for `conversionType`/`rampType`.
  /// The scraper's resolution module is the sole writer — see
  /// apps/scraper/src/resolution/claims-repository.ts::applyFieldResolution.
  /// While `conflicting`, the corresponding value column above reads
  /// `unknown`, so search/facets exclude the listing without a separate
  /// filter rule.
  conversionTypeResolution FieldResolutionState @default(unknown)
  rampTypeResolution       FieldResolutionState @default(unknown)

  // Location
  zip   String?
  city  String?
  state String?
  lat   Float?
  lng   Float?

  // Vehicle identity (VIN-only; created for listings with a valid 17-char VIN)
  vehicleId    String?
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Normalized vehicle model reference (optional, populated during enrichment)
  vehicleModelId               String?
  vehicleModelMatchConfidence  String?
  vehicleModel                 VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  // Dealer
  dealerName      String?
  dealerPhone     String?
  dealerWebsite   String?
  dealerProfileId String?
  dealerProfile   DealerProfile? @relation(fields: [dealerProfileId], references: [id])


  /// Image URLs observed on the list/card page. Detail extraction owns `images`.
  cardImages  String[] @default([])
  images      String[]
  // Raw third-party seller copy. Retained in full for WAV-feature extraction
  // by scraper agents. The public API truncates this to a short snippet
  // (see apps/api/src/routes/listings.ts snippetDescription) so that full
  // dealer copy is not reproduced verbatim in public responses.
  description String?

  // Deduplication
  isDuplicate Boolean @default(false)
  canonicalId String?
  canonical   Listing?  @relation("DuplicateOf", fields: [canonicalId], references: [id])
  duplicates  Listing[] @relation("DuplicateOf")

  status     ListingStatus @default(active)
  saleStatus SaleStatus    @default(active)
  goneAt     DateTime?
  soldAt     DateTime?

  // Publication quality gate. Source/detail jobs retain observations but do
  // not implicitly promote them into public APIs or search.
  publicationStatus ListingPublicationStatus @default(pending)
  qualityIssueCodes String[]                 @default([])
  qualityCheckedAt  DateTime?

  /// Number of consecutive complete source crawls where this listing was absent.
  /// Incremented each time a complete crawl finishes without finding this listing.
  /// Reset to 0 when the listing reappears in any complete crawl.
  missingFromCompleteCount   Int       @default(0)
  /// Timestamp of the most recent complete crawl that included this listing.
  lastSeenInCompleteCrawlAt  DateTime?

  /// WAV Search first observation of this source listing; not seller-provided.
  listedAt           DateTime
  /// Publication timestamp explicitly provided by the seller/source.
  sourceListedAt     DateTime?
  /// Modification timestamp explicitly provided by the seller/source.
  sourceUpdatedAt    DateTime?
  updatedAt          DateTime  @updatedAt
  scrapedAt          DateTime  @default(now())
  detailScrapedAt    DateTime?
  processingLockedAt DateTime?

  priceHistory      ListingPriceHistory[]
  mileageHistory    ListingMileageHistory[]
  conversionHistory ListingConversionHistory[]
  observations      ListingObservation[]
  identityDecisionsAsA VehicleIdentityDecision[] @relation("VehicleIdentityDecisionListingA")
  identityDecisionsAsB VehicleIdentityDecision[] @relation("VehicleIdentityDecisionListingB")
  listingImages     ListingImage[]
  fieldClaims       ListingFieldClaim[]
  reports           ListingReport[]

  @@unique([sourceId, sourceRecordKey])
  @@index([sourceId])
  @@index([sourceUrl])
  @@index([vin])
  @@index([vehicleId, status])
  @@index([vehicleId, listedAt])
  @@index([wavFeatures])
  @@index([isDuplicate])
  @@index([state])
  @@index([make, model])
  @@index([year])
  @@index([priceCents])
  @@index([mileage])
  @@index([listedAt])
  @@index([status])
  @@index([status, publicationStatus])
  @@index([publicationStatus])
  @@index([saleStatus])
  @@index([vehicleModelId])
  @@index([processingLockedAt])
  @@index([dealerProfileId])
  @@index([dealerName, zip])
  @@index([sourceId, status, missingFromCompleteCount], map: "listings_possibly_gone_missing_count_idx")
  @@index([status, conversionTypeResolution])
  @@index([status, rampTypeResolution])
  @@map("listings")
}

model ListingReport {
  id         String              @id @default(cuid())
  listingId  String
  listing    Listing             @relation(fields: [listingId], references: [id])
  reportType ListingReportType
  notes      String?
  status     ListingReportStatus @default(unresolved)
  reportedAt DateTime            @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@map("listing_reports")
  @@index([listingId, status])
  @@index([status, reportedAt])
}

/// One evidence-backed assertion about a single Listing field's value (#499),
/// keyed by (listingId, field, evidenceKind, sourceRef). Rows are append-only:
/// a changed observation for the same slot inserts a new row instead of
/// overwriting, preserving an auditable claim history across resolution
/// changes. `recordClaim()` (apps/scraper/src/resolution/claims-repository.ts)
/// is the sole writer and skips the insert when the incoming claim matches
/// the slot's latest row, so re-ingesting an unchanged observation is
/// idempotent and never duplicates a claim.
model ListingFieldClaim {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  /// Field this claim is about (e.g. "conversionType", "rampType"). String
  /// rather than an enum so the #499 resolver can extend to another field
  /// without a schema migration; validated by the scraper's ClaimField
  /// union at the TypeScript layer.
  field String

  /// Value this evidence asserts, using the same string vocabulary as the
  /// field's own normalized enum (e.g. "rear_entry", "in_floor", "unknown").
  claimedValue String

  /// Provenance category. Determines resolver precedence — see
  /// apps/scraper/src/resolution/resolver.ts. One of: structured_source,
  /// vehicle_text, authoritative_source, photo, generic_text.
  evidenceKind String

  /// Where this evidence came from: page URL for text/structured evidence,
  /// image URL for photo evidence. Null when there is no natural single-URL
  /// reference for this evidence kind.
  sourceRef String?

  observedAt DateTime @default(now())

  /// Extractor/analysis version that produced this claim, so a later parser
  /// change can be distinguished from a genuine source change.
  extractorVersion String

  /// 0..1 confidence for evidence kinds that produce one (chiefly `photo`).
  /// Null for deterministic text/structured extraction.
  confidence Float?

  /// False when this claim is retained for audit but excluded from
  /// resolution — e.g. a photo matched to a reused/stock image cluster, or
  /// below the minimum photo confidence. See resolver.ts::isCredible.
  eligible         Boolean @default(true)
  ineligibleReason String?

  createdAt DateTime @default(now())

  @@index([listingId, field])
  @@index([listingId, field, evidenceKind, sourceRef, observedAt])
  @@map("listing_field_claim")
}

/// Versioned audit record for a source-card or detail-page observation.
/// `reference` is populated for retryable raw-page work so one input is applied once.
model ListingObservation {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id])
  stage             String
  reference         String?
  extractionVersion String
  changedFields     String[]
  before            Json
  after             Json
  observedAt        DateTime @default(now())

  @@unique([stage, reference])
  @@index([listingId, observedAt])
  @@map("listing_observation")
}

model ListingPriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  priceCents Int
  recordedAt DateTime @default(now())

  @@index([listingId, recordedAt])
  /// Supports the market-trends time-bucket aggregation, which scans by
  /// recordedAt across listings (not scoped to one listingId).
  @@index([recordedAt])
  @@map("listing_price_history")
}

model ListingMileageHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  mileage    Int
  recordedAt DateTime @default(now())

  @@index([listingId, recordedAt])
  @@map("listing_mileage_history")
}

model ListingConversionHistory {
  id               String           @id @default(cuid())
  listingId        String
  listing          Listing          @relation(fields: [listingId], references: [id])
  conversionStatus ConversionStatus
  wavFeatures      WavFeature[]
  recordedAt       DateTime         @default(now())

  @@index([listingId, recordedAt])
  @@map("listing_conversion_history")
}

model RawPage {
  id          String    @id @default(cuid())
  url         String    @unique
  sourceId    String
  html        String
  scrapedAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([sourceId, processedAt])
  @@index([processedAt, scrapedAt])
  @@map("raw_pages")
}

model ScraperRun {
  id         String   @id @default(cuid())
  sourceId   String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  success    Boolean?
  listingsFound    Int?
  listingsNew      Int?
  listingsUpdated  Int?
  errorMessage     String?

  @@index([sourceId])
  @@map("scraper_runs")
}

// ── Research platform ──────────────────────────────────────────────────────

model VehicleModel {
  id       String  @id @default(cuid())
  make     String
  model    String
  year     Int
  trim     String?
  bodyType String?

  vehicles                   Vehicle[]
  listings                   Listing[]
  recalls                    Recall[]
  complaints                 Complaint[]
  safetyRatings              SafetyRating[]
  modelResearch              VehicleModelResearch[]
  investigations             Investigation[]
  manufacturerCommunications ManufacturerCommunication[]
  pricing                    VehicleModelPricing?

  @@unique([make, model, year, trim])
  @@index([make, model])
  @@index([year])
  @@map("vehicle_models")
}

model VehicleModelResearch {
  id              String       @id @default(cuid())
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  researchVersion Int          @default(1)
  researchedAt    DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  claims  VehicleModelClaim[]
  sources VehicleModelSource[]

  @@unique([vehicleModelId, researchVersion])
  @@index([vehicleModelId])
  @@map("vehicle_model_research")
}

model VehicleModelSource {
  id         String               @id @default(cuid())
  researchId String
  research   VehicleModelResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceName String
  sourceUrl  String
  fetchedAt  DateTime             @default(now())

  claims VehicleModelClaim[]

  @@index([researchId])
  @@map("vehicle_model_source")
}

model VehicleModelClaim {
  id         String               @id @default(cuid())
  researchId String
  research   VehicleModelResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceId   String?
  source     VehicleModelSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  field      String
  claimText  String
  confidence String               @default("medium")
  createdAt  DateTime             @default(now())

  @@index([researchId])
  @@index([researchId, field])
  @@map("vehicle_model_claim")
}

model Recall {
  id              String       @id @default(cuid())
  nhtsaCampaignId String
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component       String
  summary         String
  remedy          String?
  reportedAt      DateTime
  refreshedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@unique([nhtsaCampaignId, vehicleModelId])
  @@index([vehicleModelId])
  @@map("recalls")
}

model Complaint {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  mileage        Int?
  crashInvolved  Boolean      @default(false)
  reportedAt     DateTime
  refreshedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("complaints")
}

model SafetyRating {
  id              String       @id @default(cuid())
  vehicleModelId  String
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id])
  nhtsaVehicleId  Int          @unique
  description     String?
  overallRating   Int?
  frontCrashRating Int?
  sideCrashRating  Int?
  rolloverRating   Int?
  rolloverRatingText String?
  refreshedAt     DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("safety_ratings")
}

/// NHTSA investigation record. Source: https://api.nhtsa.gov/investigations/investigationsByVehicle
model Investigation {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  openedDate     DateTime
  closedDate     DateTime?
  outcome        String?
  sourceUrl      String
  refreshedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("investigation")
}

/// NHTSA manufacturer communication (Technical Service Bulletin or equivalent).
/// Source: https://api.nhtsa.gov/tsbs/tsbsByVehicle
model ManufacturerCommunication {
  id             String       @id @default(cuid())
  nhtsaId        String       @unique
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  component      String
  summary        String
  issuedDate     DateTime
  sourceUrl      String
  refreshedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([vehicleModelId])
  @@map("manufacturer_communication")
}

model ConversionBrand {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  website        String?
  nmedaCertified Boolean  @default(false)
  founded        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ConversionProduct[]

  @@map("conversion_brands")
}

model ConversionProduct {
  id                  String          @id @default(cuid())
  brandId             String
  brand               ConversionBrand @relation(fields: [brandId], references: [id])
  name                String
  conversionType      ConversionType
  rampType            RampType
  floorLoweringInches Float?
  msrpCents           Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([brandId])
  @@map("conversion_products")
}

model VehicleStats {
  id                String   @id @default(cuid())
  make              String
  model             String
  year              Int?
  avgLifespanMiles  Int?
  reliabilityScore  Float?
  reliabilitySource String?
  jdPowerScore      Float?
  dataSourceName    String?
  dataSourceUrl     String?
  methodology       String?
  refreshedAt       DateTime?
  createdAt         DateTime @default(now())

  @@unique([make, model, year])
  @@index([make, model])
  @@map("vehicle_stats")
}

model NmeaDealer {
  id           String   @id @default(cuid())
  name         String
  address      String?
  state        String?
  zip          String?
  phone        String?
  website      String?
  qapCertified Boolean   @default(false)
  city         String?
  lat          Float?
  lng          Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([state])
  @@map("nmea_dealers")
}

// ── Dealer enrichment ─────────────────────────────────────────────────────

model DealerProfile {
  id            String   @id @default(cuid())
  name          String
  zip           String
  googlePlaceId String?  @unique
  rating        Float?
  reviewCount   Int?
  hours         Json?
  enrichedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews  DealerReview[]
  listings Listing[]

  @@unique([name, zip])
  @@map("dealer_profiles")
}

model DealerReview {
  id          String        @id @default(cuid())
  dealerId    String
  dealer      DealerProfile @relation(fields: [dealerId], references: [id])
  authorName  String
  rating      Int
  text        String
  publishedAt DateTime
  source      String        // "google", "dealerrater", etc.

  @@unique([dealerId, source, publishedAt, authorName])
  @@index([dealerId])
  @@map("dealer_reviews")
}

// ── Image integrity ────────────────────────────────────────────────────────

/// Stability classifications for a single image observed on a listing.
/// - `vehicle_photo`: passes size/content-type checks and is not classified as chrome/placeholder.
/// - `placeholder`: reused above the cross-vehicle threshold — likely stock/dealer imagery.
/// - `site_chrome`: logo, banner, icon, staff/team photo, tracking pixel, etc.
/// - `excluded`: failed download (timeout, bad content-type, oversized, 4xx/5xx).
enum ImageKind {
  vehicle_photo
  placeholder
  site_chrome
  excluded
}

/// Per-image metadata record. One row per (listingId, originalUrl) pair.
/// Raw image bytes are never persisted — only hashes derived from a bounded download.
/// `exactHash`  = hex SHA-256 of the response body (identical bytes).
/// `pHash`      = 64-bit difference-hash as a hex string (perceptual similarity).
/// Both fields are null until the image has been successfully downloaded and analysed.
model ListingImage {
  id             String    @id @default(cuid())
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id])

  /// URL exactly as observed in the page source.
  originalUrl    String
  /// URL after stripping tracking parameters and normalising CDN variants.
  normalizedUrl  String

  /// 0-based position in the gallery (card or detail page order).
  position       Int
  /// When this image was first recorded for this listing.
  observedAt     DateTime  @default(now())

  kind           ImageKind @default(vehicle_photo)

  /// Width in pixels, when reported by the source or detectable from metadata.
  widthPx        Int?
  /// Height in pixels, when reported by the source or detectable from metadata.
  heightPx       Int?

  /// Hex SHA-256 of the response body. Null if download failed or was skipped.
  exactHash      String?
  /// 64-bit difference-hash as a 16-char hex string. Null if download failed/skipped.
  pHash          String?

  /// Monotonically-increasing version so re-analysis can detect stale rows.
  analysisVersion Int       @default(1)

  /// Cluster this image belongs to (set after clustering analysis).
  clusterId      String?
  cluster        ImageCluster? @relation(fields: [clusterId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([listingId, originalUrl])
  @@index([listingId])
  @@index([exactHash])
  @@index([pHash])
  @@index([clusterId])
  @@index([normalizedUrl])
  @@map("listing_image")
}

/// A group of images that share the same exact hash (byte-identical) or whose
/// pHash values fall within the near-duplicate Hamming distance threshold.
/// Clusters are created/updated by the image-integrity-analyzer job.
model ImageCluster {
  id              String   @id @default(cuid())

  /// `exact`  — all members share the same SHA-256 hash.
  /// `near`   — members share pHash within the configured Hamming distance.
  clusterType     String

  /// Representative hash for the cluster (exact: the SHA-256; near: the pHash centroid / first member).
  representativeHash String

  /// Number of distinct listings this cluster appears on.
  listingCount    Int      @default(0)
  /// Number of distinct sources this cluster appears across.
  sourceCount     Int      @default(0)
  /// Number of distinct Vehicle ids (non-null vehicleId) this cluster spans.
  vehicleCount    Int      @default(0)

  /// True when the cluster spans more than one distinct VIN/vehicle group,
  /// making it ineligible as verification evidence for any single vehicle.
  crossVehicle    Boolean  @default(false)

  /// True when reuse exceeds the configured placeholder threshold and this
  /// cluster is classified as probable stock/dealer/placeholder imagery.
  isPlaceholder   Boolean  @default(false)

  /// Human-readable description of why this cluster was flagged (e.g.
  /// "reused across 12 vehicles from 3 sources" or "matches known site-chrome hash").
  reasonCode      String?

  /// Monotonically-increasing analysis version so stale cluster rows can be detected.
  analysisVersion Int      @default(1)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  images          ListingImage[]

  @@unique([clusterType, representativeHash])
  @@index([clusterType])
  @@index([isPlaceholder])
  @@index([crossVehicle])
  @@map("image_cluster")
}

// ── Remote config (append-only) ────────────────────────────────────────────

enum ConfigEntryType {
  string
  number
  boolean
  json
  secret
}

model ConfigEntry {
  id             String          @id @default(cuid())
  key            String
  value          Json?
  type           ConfigEntryType
  description    String?
  encryptedValue String?
  hint           String?
  createdAt      DateTime        @default(now())
  createdBy      String?

  @@index([key, createdAt])
  @@map("config_entry")
}

/// Original MSRP stored at the model/trim level. Source: fueleconomy.gov.
model VehicleModelPricing {
  id                  String       @id @default(cuid())
  vehicleModelId      String
  vehicleModel        VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  originalMsrpCents   Int?
  destinationFeeCents Int?
  currency            String       @default("USD")
  sourceName          String
  sourceUrl           String
  sourceFetchedAt     DateTime     @default(now())
  sourcePayload       Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([vehicleModelId])
  @@map("vehicle_model_pricing")
}

// ── Paid API tiers ───────────────────────────────────────────────────────────
// Key provisioning, authentication, and per-key rate limiting for the public
// `/v1/` API (#453). `tier` gates access to historical-data endpoints added
// in #454 (VIN history, dealer listing history, market trends); `rateLimitRpm`
// independently governs request throughput and defaults from tier at
// creation/upgrade time (see `defaultRateLimitForTier` in
// `apps/api/src/services/api-key-tier.ts`) but may be overridden per key.
enum ApiKeyTier {
  FREE
  PRO
  ENTERPRISE
}

model ApiKey {
  id           String     @id @default(cuid())
  /// SHA-256 hex digest of the raw key. The raw key itself is never stored.
  keyHash      String     @unique
  ownerEmail   String
  tier         ApiKeyTier @default(FREE)
  /// Requests allowed per minute for this key (sliding window; see
  /// `plugins/api-key-auth.ts`). Independent of `tier` so individual keys can
  /// be tuned without a tier change.
  rateLimitRpm Int        @default(60)
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?

  @@map("api_key")
}

/// Durable checkpoint for the single-owner search indexer poller (#669).
/// One row per named projection — `id` is the projection name (e.g.
/// "listings"). Advances only after the corresponding search-engine write
/// commits, so a crash between the index write and the checkpoint write
/// safely replays the same batch (syncListings is idempotent).
model SearchIndexerCheckpoint {
  id            String   @id
  lastUpdatedAt DateTime
  lastId        String
  updatedAt     DateTime @updatedAt

  @@map("search_indexer_checkpoint")
}
