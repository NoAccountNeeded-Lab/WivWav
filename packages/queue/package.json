    "bullmq": "^5.81.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@wivwav/config": "workspace:*",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
