{
  "name": "@wivwav/types",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./operator-settings": {
      "types": "./dist/operator-settings.d.ts",
      "import": "./dist/operator-settings.js",
      "default": "./dist/operator-settings.js"
    },
    "./worker-protocol": {
      "types": "./dist/worker-protocol.d.ts",
      "import": "./dist/worker-protocol.js",
      "default": "./dist/worker-protocol.js"
    },
    "./scraper-gateway": {
      "types": "./dist/scraper-gateway.d.ts",
      "import": "./dist/scraper-gateway.js",
      "default": "./dist/scraper-gateway.js"
    },
    "./listing-validator": {
      "types": "./dist/listing-validator.d.ts",
      "import": "./dist/listing-validator.js",
      "default": "./dist/listing-validator.js"
    },
    "./listing-readiness": {
      "types": "./dist/listing-readiness.d.ts",
      "import": "./dist/listing-readiness.js",
      "default": "./dist/listing-readiness.js"
    },
    "./http-enrich-gateway": {
      "types": "./dist/http-enrich-gateway.d.ts",
      "import": "./dist/http-enrich-gateway.js",
      "default": "./dist/http-enrich-gateway.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@wivwav/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
