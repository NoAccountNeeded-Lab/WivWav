{
  "name": "@wivwav/scraper-sources",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:fixtures": "vitest run src/sources/fixture-contract.test.ts",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "@wivwav/logger": "workspace:*",
    "@wivwav/queue": "workspace:*",
    "@wivwav/search": "workspace:*",
    "@wivwav/types": "workspace:*",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@wivwav/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
