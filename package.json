{
  "name": "wivwav",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "typecheck:affected": "turbo typecheck --filter=\"...[origin/main]\"",
    "lint:affected": "turbo lint --filter=\"...[origin/main]\"",
    "test:affected": "turbo test --filter=\"...[origin/main]\"",
    "check:affected": "turbo typecheck lint test --filter=\"...[origin/main]\"",
    "sdlc:report": "LOOKBACK_DAYS=${LOOKBACK_DAYS:-30} bash scripts/sdlc-report.sh",
    "db:generate": "pnpm --filter @wivwav/db generate",
    "db:migrate": "pnpm --filter @wivwav/db migrate",
    "db:migrate:create": "pnpm --filter @wivwav/db migrate:create",
    "db:push": "pnpm --filter @wivwav/db db:push",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "wivwav": "pnpm --filter @wivwav/sdlc-cli run cli --",
    "agents": "pnpm --filter @wivwav/agents run cli --",
    "job:detail-crawl": "pnpm --filter @wivwav/scraper job:detail-crawl",
    "job:detail-extract": "pnpm --filter @wivwav/scraper job:detail-extract",
    "job:geocode": "pnpm --filter @wivwav/scraper job:geocode"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
