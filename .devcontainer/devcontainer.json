{
  "name": "WivWav Dev",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  "forwardPorts": [4000, 4001, 4002],
  "portsAttributes": {
    "4000": { "label": "Web (Next.js)" },
    "4001": { "label": "API (Fastify)" },
    "4002": { "label": "Ops (Next.js)" }
  },

  "postCreateCommand": "pnpm install && pnpm db:generate && cp -n apps/api/.env.example apps/api/.env && cp -n apps/ops/.env.example apps/ops/.env.local && cp -n apps/web/.env.example apps/web/.env.local && cp -n packages/db/.env.example packages/db/.env",

  "remoteEnv": {
    "DATABASE_URL": "postgresql://wav:wav@postgres:5432/wivwav",
    "MEILISEARCH_HOST": "http://meilisearch:7700",
    "MEILISEARCH_API_KEY": "wav_master_key",
    "VALKEY_URL": "redis://valkey:6379",
    "QUEUE_REDIS_URL": "redis://valkey:6379",
    "NEXT_PUBLIC_API_URL": "http://localhost:4001",
    "API_INTERNAL_URL": "http://localhost:4001",
    "CONFIG_API_URL": "http://localhost:4001",
    "CONFIG_ENCRYPTION_SECRET": "0e1735cf48baa21c71a376a432ebd30b400a118feaecce8ea43f864cf27b2f61",
    "INTERNAL_API_SECRET": "41ddf2d6dfad63f18a7fa42d4ddc82da47fd7ac0f9e6c55530078f7c2ca941c2",
    "OPS_SESSION_SECRET": "41ddf2d6dfad63f18a7fa42d4ddc82da47fd7ac0f9e6c55530078f7c2ca941c2",
    "OPS_ADMIN_USERNAME": "operator",
    "OPS_ADMIN_PASSWORD": "changeme-local-dev-password",
    "TURBO_ENV_MODE": "loose"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
